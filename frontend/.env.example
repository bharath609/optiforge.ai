# Optional: point the site at a live backend (adds GPT-6 Astra understanding).
# Leave unset to use the built-in browser solver only.
VITE_API_URL=https://<your-backend-host>

# Optional: browser-direct AI for free-form questions (no backend needed).
# Use a referrer-restricted key. Works with any OpenAI-compatible endpoint.
# Example for Google Gemini (free tier, no card):
VITE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
VITE_AI_API_KEY=your_gemini_api_key_here
# Use the exact Flash model id shown in Google AI Studio (e.g. gemini-2.5-flash):
VITE_AI_MODEL=gemini-2.5-flash
# Example for Groq (free tier, no card) — needs a backend (no browser CORS):
# VITE_AI_BASE_URL=https://api.groq.com/openai/v1
# VITE_AI_API_KEY=your_groq_api_key_here
# VITE_AI_MODEL=openai/gpt-oss-20b
